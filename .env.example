# ==============================================================================
# Agentic Universe - Interaction Ledger Environment Configuration
# ==============================================================================

# Application Environment Mode
# Options: development | test | staging | production
# Default: development
APP_ENV=development

# Database Path (optional, defaults to data/ledger.db)
LEDGER_DB_PATH=data/ledger.db

# ==============================================================================
# Cryptographic Key Configuration
# ==============================================================================
# In 'development' and 'test' modes, default keys are provided for local evaluation.
# In 'staging' and 'production' modes, the following variables MUST be securely configured.
#
# PII_SECRET_KEY: Exactly 64 hexadecimal characters representing a 32-byte AES-256 key.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
PII_SECRET_KEY=

# PII_HASH_SALT: Secure secret string for HMAC-SHA256 blind indexing of phone numbers.
# Minimum 16 characters in production.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_HASH_SALT=
